{
  "name": "@swartzrock/llm-now-core",
  "version": "0.0.0",
  "description": "Headless provider, generation, streaming, cancellation, safety, and transcript routing for trusted Node and Bun hosts",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swartzrock/llm-now.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@3leaps/string-metrics-wasm": "0.3.11",
    "@swartzrock/byok-runtime": "2.4.1",
    "unicode-case-folding": "1.1.1"
  }
}
