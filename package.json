{
  "name": "llm-now-workspace",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "bun index.ts",
    "test": "bun run core:build && bun test",
    "typecheck": "bun run core:build && tsc --noEmit",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version",
    "runtime:smoke": "bun run core:build && bun tests/runtime-compile-smoke.ts",
    "check": "bun run core:build && bun test && tsc --noEmit && bun tests/runtime-compile-smoke.ts",
    "core:build": "bun scripts/build-core.ts",
    "core:pack:verify": "bun run core:build && bun scripts/verify-core-package.ts",
    "build:native": "bun scripts/build.ts",
    "release:validate": "bun run core:build && bun scripts/release-validate.ts packages"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@manypkg/get-packages": "1.1.3",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@swartzrock/byok-runtime": "2.4.1",
    "fflate": "0.8.2",
    "picocolors": "1.1.1",
    "typescript": "5.9.3"
  }
}
